# Audio generation server: Kokoro-82M TTS (+ OpenVoice V2 custom voices) + MusicGen-small on CUDA
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch

# espeak-ng is required by kokoro's phonemizer backend
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    espeak \
    ffmpeg \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi==0.115.* \
    "uvicorn[standard]==0.34.*" \
    kokoro>=0.9.4 \
    soundfile \
    "transformers>=4.48" \
    accelerate \
    httpx

# OpenVoice V2 tone-color converter for custom voices. Its setup.py pins
# numpy 1.22 / gradio / whisper, which would break Kokoro, so install it
# without deps and add only what the converter path imports.
RUN pip install --no-cache-dir \
    librosa \
    wavmark==0.0.3 \
    inflect \
    unidecode \
    eng_to_ipa \
    pypinyin \
    cn2an \
    jieba \
    && pip install --no-cache-dir --no-deps \
    "MyShell-OpenVoice @ https://github.com/myshell-ai/OpenVoice/archive/74a1d147b17a8c3092dd5430504bd83ef6c7eb23.zip"

COPY audio_server.py tts_text.py voice_clone.py /app/
COPY audio/ /app/audio/

WORKDIR /app
EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=60s \
    CMD curl -sf http://localhost:8082/health || exit 1

CMD ["python3", "/app/audio_server.py"]
