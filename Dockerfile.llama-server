# Pinned to a build, not the moving server-cuda12 tag: a rebuild used whatever
# server-cuda12 the local cache held, and `docker compose up --build alpaca-proxy`
# (which rebuilds this dependency too) silently took llama-server from b12211 back
# to b12019, whose preset parser rejected moe-cache-cpu-share and crash-looped.
# Upgrade by bumping the tag (check flags first: AGENTS.md "llama.cpp Preset Keys").
# LLAMA_BASE_IMAGE (compose passes it from .env) can point at a llama.cpp server image built from
# source by scripts/build-llama-image.sh, for a model newer than the newest pinned official image
# (Inkling 2 Mini needed b12708; the newest pinned server-cuda12 image was b12679).
ARG LLAMA_BASE_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda12-b12211
FROM ${LLAMA_BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
