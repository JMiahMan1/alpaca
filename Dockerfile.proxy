FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli curl && rm -rf /var/lib/apt/lists/*
RUN pip install fastapi uvicorn httpx psutil python-multipart
COPY alpaca-proxy.py .
COPY alpaca-puller.py .
COPY alpaca_puller.py .
COPY benchmark-configs.py .
COPY analyzer.py .
COPY telemetry_monitor.py .
COPY online_providers.py .
RUN useradd -u 1000 -m -s /bin/bash alpaca && chown -R alpaca:alpaca /app
USER alpaca
CMD ["python", "alpaca-proxy.py"]
